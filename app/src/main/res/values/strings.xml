    <string name="key_clear_word">Clear</string>
    <!-- Turns the keypad to the scientific functions -->
    <string name="key_functions">fx</string>
    <!-- Turns the keypad back to the digits -->
    <string name="key_numbers">123</string>
    <!-- Angles are in degrees; shown on the key that changes it -->
    <string name="key_degrees">deg</string>
    <string name="key_radians">rad</string>

